<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened Runtime is enabled for this bundle (tauri.conf.json leaves
      bundle.macOS.hardenedRuntime at its default, true). Under the hardened
      runtime macOS refuses camera and microphone access unless the app is
      signed with these entitlements - TCC never even prompts without them,
      which is why the call UI had no device list.

      com.apple.security.device.camera     - hardened runtime: camera
      com.apple.security.device.audio-input - hardened runtime: microphone
      com.apple.security.device.microphone  - App Sandbox flavour; harmless
                                              here and a fallback on older macOS.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>
</dict>
</plist>
