<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Maretrix</string>
    <key>CFBundleName</key>
    <string>Maretrix</string>
    <!-- Liquid Glass (macOS 26+) icon: the bundler compiles icons/AppIcon.icon
         to Assets.car and this key makes LaunchServices read it. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSCameraUsageDescription</key>
    <string>Maretrix needs camera access for video calls.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Maretrix needs microphone access for voice and video calls.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Maretrix needs your location to share it in a conversation.</string>
    <!-- APP-ICON ALTERNATES START -->
    <key>TauriAppIconAliases</key>
    <dict>
      <key>propeller</key>
      <string>AppIconPropeller</string>
      <key>agender</key>
      <string>AppIconAgender</string>
      <key>bisexual</key>
      <string>AppIconBisexual</string>
      <key>trans</key>
      <string>AppIconTrans</string>
      <key>transgradient</key>
      <string>AppIconTransgradient</string>
      <key>intersex</key>
      <string>AppIconIntersex</string>
      <key>lesbian</key>
      <string>AppIconLesbian</string>
      <key>mlm</key>
      <string>AppIconMlm</string>
      <key>pride</key>
      <string>AppIconPride</string>
    </dict>
    <!-- APP-ICON ALTERNATES END -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>voip</string>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
